{# button.html.twig #}
{% macro primary(href, icon, label) %}
    <a href="{{ href }}"
       class="{{ tokens.button.primary }}">
        {% if icon %}
            <span class="material-symbols-outlined">{{ icon }}</span>
        {% endif %}
        {{ label }}
    </a>
{% endmacro %}

{% macro secondary(href, icon, label) %}
    <a href="{{ href }}"
       class="{{ tokens.button.secondary }}">
        {% if icon %}
            <span class="material-symbols-outlined">{{ icon }}</span>
        {% endif %}
        {{ label }}
    </a>
{% endmacro %}
