{# button.html.twig #}
{% macro primary(href, icon, label, onclick) %}
    <a href="{{ href }}"
       {% if onclick %}onclick="{{ onclick }}"{% endif %}
       class="{{ tokens.button.primary }}">
        {% if icon %}
            <span class="material-symbols-outlined shrink-0">{{ icon }}</span>
        {% endif %}
        <span class="truncate">{{ label }}</span>
    </a>
{% endmacro %}

{% macro secondary(href, icon, label, onclick) %}
    <a href="{{ href }}"
       {% if onclick %}onclick="{{ onclick }}"{% endif %}
       class="{{ tokens.button.secondary }}">
        {% if icon %}
            <span class="material-symbols-outlined shrink-0">{{ icon }}</span>
        {% endif %}
        <span class="truncate">{{ label }}</span>
    </a>
{% endmacro %}
