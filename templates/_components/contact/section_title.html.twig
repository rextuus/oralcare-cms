{# section_title.html.twig #}
{% macro render(icon, title) %}
    <h2 class="flex items-center gap-3 mb-6 text-xl font-semibold text-slate-800 dark:text-slate-100">
        {% import "_components/contact/icon.html.twig" as iconUI %}
        {{ iconUI.render(icon) }}
        <span>{{ title }}</span>
    </h2>
{% endmacro %}
