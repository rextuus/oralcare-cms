{% macro render(service) %}
    <article class="group flex flex-col {{ tokens.card.soft }} rounded-2xl sm:rounded-3xl overflow-hidden hover:shadow-2xl hover:-translate-y-1 transition-all duration-500">
        <div class="h-40 sm:h-48 overflow-hidden relative">
            <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent z-10 opacity-60 sm:opacity-40 group-hover:opacity-100 transition-opacity duration-500"></div>

            {# Icon in der linken unteren Ecke des Bildes #}
            <div class="{{ tokens.icon.service_card.container }}">
                {% if service.icon is not empty %}
                    {% set icon = service.icon|first %}
                    {% if icon.thumbnails is defined and icon.thumbnails[tokens.icon.service_card.format] is defined %}
                        <img src="{{ icon.thumbnails[tokens.icon.service_card.format] }}" alt="{{ icon.title }}" class="{{ tokens.icon.service_card.img }}">
                    {% elseif icon.url is defined %}
                        <img src="{{ icon.url }}" alt="{{ icon.title }}" class="{{ tokens.icon.service_card.img }}">
                    {% endif %}
                {% else %}
                    <span class="material-symbols-outlined text-base sm:text-xl">verified</span>
                {% endif %}
            </div>

            {% if service.image is not empty or service.image_mobile is not empty %}
                {% set image = service.image|first %}
                {% set image_mobile = service.image_mobile|first|default(image) %}
                {% set variant = service.variant|default('square') %}
                {% set mobile_variant = service.mobile_variant|default('square') %}

                {% set quality = service.quality|default('standard') %}
                {% set mobile_quality = service.mobile_quality|default('standard') %}
                {% set desktop_format = (quality == 'best' ? variant ~ '-xl' : variant ~ '-lg') %}
                {% set mobile_format = (mobile_quality == 'best' ? mobile_variant ~ '-xl' : mobile_variant ~ '-md') %}

                <picture>
                    <source media="(max-width: 639px)" srcset="{{ image_mobile.thumbnails[mobile_format]|default(image_mobile.url) }}">
                    <img src="{{ image.thumbnails[desktop_format]|default(image.thumbnails['square-md'])|default(image.url) }}"
                         alt="{{ service.title }}"
                         class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                         style="object-position: {{ image.focusX|default(50) }}% {{ image.focusY|default(50) }}%">
                </picture>
            {% else %}
                <img alt="{{ service.title }}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" src="https://images.unsplash.com/photo-1588776814546-1ffcf47267a5?q=80&w=800&auto=format&fit=crop">
            {% endif %}
        </div>
        <div class="px-3 py-4 sm:p-6 flex-1 flex flex-col">
            <h2 class="text-sm sm:text-lg font-bold {{ tokens.text.title }} leading-tight mb-3 sm:mb-4">{{ service.title }}</h2>
            <div class="{{ tokens.text.body }} mb-4 sm:mb-6 text-[13px] sm:text-sm leading-relaxed" style="-webkit-line-clamp: unset !important; display: block !important;">
                {{ service.description|raw }}
            </div>
            {% if service.link is not empty %}
                <a class="mt-auto inline-flex items-center font-bold text-primary hover:text-blue-600 transition-colors group/link" href="{{ sulu_content_path(service.link|first.url) }}">
                    {{ 'Mehr erfahren'|trans }}
                    <span class="material-symbols-outlined text-sm ml-1 group-hover/link:translate-x-1 transition-transform">arrow_forward</span>
                </a>
            {% endif %}
        </div>
    </article>
{% endmacro %}
