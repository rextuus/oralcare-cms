{% extends 'base.html.twig' %}

{% block content %}

    {% set common_settings = sulu_snippet_load_by_area('common_settings') %}
    {% set global_best_quality = common_settings.content.force_best_quality|default(false) %}
    {% import "_components/contact/button.html.twig" as btn %}

    {# Hero Section #}
    <header class="relative pt-24 pb-20 overflow-hidden w-full max-w-full overflow-x-hidden">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 w-full">
            <div class="max-w-3xl min-w-0 flex flex-col items-center text-center mx-auto overflow-hidden">
                {% if content.hero_badge is not empty %}
                    <span class="inline-block py-1 px-3 rounded-full bg-blue-100 dark:bg-blue-900/30 text-primary text-sm font-semibold mb-4 w-fit">
                        {{ content.hero_badge }}
                    </span>
                {% endif %}
                <h1 class="text-5xl md:text-7xl font-extrabold mb-6 tracking-tight leading-[1.1] {{ tokens.text.title }} break-words hyphens-auto min-w-0 w-full max-w-full">
                    {{ content.title|raw }}
                </h1>
                {% if content.hero_subtitle is not empty %}
                    <p class="text-xl md:text-2xl {{ tokens.text.body }} leading-relaxed max-w-2xl break-words opacity-90">
                        {{ content.hero_subtitle|raw }}
                    </p>
                {% endif %}
                {% if content.hero_description is not empty %}
                    <div class="mt-8 text-lg {{ tokens.text.body }} leading-relaxed max-w-3xl opacity-80 prose dark:prose-invert">
                        {{ content.hero_description|raw }}
                    </div>
                {% endif %}
            </div>
        </div>
        <div class="absolute top-0 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-primary/10 rounded-full blur-[120px] -z-10"></div>
    </header>

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-24">
        <div class="bg-slate-50/50 dark:bg-slate-900/50 rounded-[3rem] p-8 md:p-12 lg:p-16 border border-slate-100 dark:border-slate-800 shadow-inner">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
                {% import "_components/service_card.html.twig" as card %}
                {% for service in content.services_list %}
                    {{ card.render(service) }}
                {% endfor %}
            </div>
        </div>

        {# CTA Section #}
        {% if content.cta_title is not empty or content.cta_subtitle is not empty %}
            <section class="mt-32 relative rounded-3xl overflow-hidden bg-primary px-8 py-16 text-center text-white">
                <div class="relative z-10 max-w-2xl mx-auto">
                    <h2 class="text-3xl md:text-4xl font-bold mb-4">{{ content.cta_title|default('Bereit zu buchen?'|trans) }}</h2>
                    {% if content.cta_subtitle is not empty %}
                        <p class="text-blue-100 text-lg mb-10">
                            {{ content.cta_subtitle|raw }}
                        </p>
                    {% endif %}
                    {% if content.cta_button_link is not empty %}
                        {{ btn.secondary(
                            sulu_content_path(content.cta_button_link|first.url),
                            'calendar_month',
                            content.cta_button_text|default('Termin jetzt buchen'|trans)
                        ) }}
                    {% endif %}
                </div>
                <div class="absolute top-0 right-0 p-8 opacity-10 pointer-events-none">
                    <span class="material-symbols-outlined text-[12rem] !text-white">calendar_month</span>
                </div>
                <div class="absolute bottom-0 left-0 p-8 opacity-10 pointer-events-none">
                    <span class="material-symbols-outlined text-[8rem] !text-white">verified</span>
                </div>
            </section>
        {% endif %}
    </main>
{% endblock %}
