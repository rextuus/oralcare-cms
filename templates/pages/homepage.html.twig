{% extends 'base.html.twig' %}

{% block content %}

    {% set common_settings = sulu_snippet_load_by_area('common_settings') %}
    {% set global_best_quality = common_settings.content.force_best_quality|default(false) %}

    {% set footerSettings = sulu_snippet_load_by_area('footer_settings') %}
    {% set addressSettings = sulu_snippet_load_by_area('address_settings') %}
    {% import "_components/contact/button.html.twig" as btn %}
    {% import "_components/contact/emergency_box.html.twig" as emergency %}

    {# Hero Section #}
    <section class="relative pt-16 pb-20 lg:pt-32 lg:pb-32 bg-slate-100 dark:bg-slate-900/50 flex flex-col items-center w-full max-w-full overflow-x-hidden transition-colors duration-500 ease-in-out">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 w-full flex flex-col items-center">
            <div class="flex flex-col lg:flex-row-reverse gap-8 lg:gap-12 items-center w-full min-w-0 max-w-full">
                <div class="space-y-8 animate-in fade-in slide-in-from-right-8 duration-700 min-w-0 w-full flex flex-col max-w-full lg:flex-1 overflow-hidden">
                    <div>
                        {% if content.hero_badge is not empty %}
                            <span class="inline-block py-1 px-4 rounded-full bg-blue-100 dark:bg-blue-900/30 text-primary font-semibold text-sm mb-4 w-fit transition-colors duration-500">
                            {{ content.hero_badge }}
                        </span>
                        {% endif %}
                        <h1 class="text-4xl sm:text-5xl lg:text-7xl font-display font-bold {{ tokens.text.title }} leading-[1.1] break-words hyphens-auto min-w-0 w-full max-w-full overflow-hidden transition-colors duration-500">
                            {{ content.title|raw }}
                        </h1>
                        {% if content.hero_subtitle is not empty %}
                            <p class="mt-6 text-lg {{ tokens.text.body }} max-w-xl leading-relaxed break-words overflow-hidden transition-colors duration-500">
                                {{ content.hero_subtitle|raw }}
                            </p>
                        {% endif %}
                    </div>
                    <div class="flex flex-col sm:flex-row gap-4">
                        {% if common_settings.content.enable_online_booking|default(false) %}
                            {% set booking_url = sulu_content_path('/contact') %}
                            {% set booking_onclick = null %}
                            {% if common_settings.content.dr_flex_practice_id|default(false) %}
                                {% set booking_url = 'javascript:triggerDrFlex()' %}
                            {% endif %}
                            {{ btn.primary(booking_url, 'calendar_today', 'Termin online buchen'|trans, booking_onclick) }}
                        {% endif %}
                        {# Der zweite Button wechselt jetzt ebenfalls flüssig den Rahmen, Hintergrund und Textfarbe #}
                        {{ btn.secondary(
                            content.hero_services_link is not empty ? sulu_content_path(content.hero_services_link.url) : '#services',
                            null,
                            'Leistungen ansehen'|trans
                        ) }}
                    </div>
                </div>
                <div class="relative animate-in fade-in zoom-in duration-1000 w-full max-w-[500px] mx-auto lg:max-w-none min-w-0 flex flex-col items-center max-w-full lg:flex-1">
                    <div class="absolute -top-6 -left-6 w-24 h-24 bg-blue-100 dark:bg-blue-900/20 rounded-full blur-2xl -z-10 transition-colors duration-500"></div>
                    <div class="absolute -bottom-10 -right-10 w-40 h-40 bg-primary/20 rounded-full blur-3xl -z-10 transition-colors duration-500"></div>
                    <div class="relative rounded-[2.5rem] w-full max-w-full">
                        <div class="rounded-[2.5rem] overflow-hidden">
                            {% if content.hero_image is not empty or content.hero_image_mobile is not empty %}
                                {% set image = content.hero_image|first %}
                                {% set image_mobile = content.hero_image_mobile|first|default(image) %}
                                {% set variant = content.hero_image_variant|default('vertical') %}
                                {% set mobile_variant = content.hero_image_mobile_variant|default('vertical') %}

                                {% set default_quality = global_best_quality ? 'best' : 'standard' %}

                                {% set quality = content.hero_image_quality|default(default_quality, true) %}
                                {% set mobile_quality = content.hero_image_mobile_quality|default(default_quality, true) %}
                                {% if quality == 'best' or true %}
                                    {% set desktop_format = variant ~ '-xl' %}
                                {% else %}
                                    {% set desktop_format = variant ~ '-lg' %}
                                {% endif %}
                                {% if mobile_quality == 'best' or true %}
                                    {% set mobile_format = mobile_variant ~ '-xl' %}
                                {% else %}
                                    {% set mobile_format = mobile_variant ~ '-md' %}
                                {% endif %}

                                <picture>
                                    <source media="(max-width: 639px)" srcset="{{ image_mobile.thumbnails[mobile_format]|default(image_mobile.url) }}">
                                    <img src="{{ image.thumbnails[desktop_format]|default(image.thumbnails['vertical-lg'])|default(image.url) }}"
                                         alt="{{ image.title }}"
                                         class="w-full h-[300px] sm:h-[400px] lg:h-[600px] {{ variant == 'horizontal' ? 'lg:h-[400px]' : '' }} object-cover max-w-full block"
                                         style="object-position: {{ image.focusX|default(50) }}% {{ image.focusY|default(50) }}%">
                                </picture>
                            {% else %}
                                <img alt="Smiling male dentist in a modern office" class="w-full h-[300px] sm:h-[400px] lg:h-[600px] object-cover max-w-full block" src="https://images.unsplash.com/photo-1622253692010-333f2da6031d?q=80&w=1964&auto=format&fit=crop">
                            {% endif %}
                        </div>

                        {# Das schwebende "Nächster freier Termin"-Overlay fadet jetzt ebenfalls geschmeidig mit #}
                        {% if content.hero_avail_title is not empty or content.hero_avail_text is not empty %}
                            <div class="absolute bottom-6 left-4 right-4 sm:left-8 sm:right-8 bg-white/90 dark:bg-slate-900/90 backdrop-blur p-4 sm:p-6 rounded-2xl shadow-xl flex items-center gap-4 border border-white/20 z-10 transition-colors duration-500 ease-in-out">
                                <div class="{{ tokens.icon.circle }}">
                                    <span class="material-symbols-outlined text-green-600 dark:text-slate-900 transition-colors duration-500">verified</span>
                                </div>
                                <div>
                                    <p class="text-xs sm:text-sm font-semibold {{ tokens.text.title }} transition-colors duration-500">
                                        {{ content.hero_avail_title|default('Nächster freier Termin'|trans) }}
                                    </p>
                                    <p class="text-sm sm:text-base text-primary dark:text-blue-400 font-bold transition-colors duration-500">
                                        {{ content.hero_avail_text|default('Heute, 14:30 Uhr'|trans) }}
                                    </p>
                                </div>
                            </div>
                        {% else %}
                            <div class="absolute bottom-6 left-4 right-4 sm:left-8 sm:right-8 bg-white/90 dark:bg-slate-900/90 backdrop-blur p-4 sm:p-6 rounded-2xl shadow-xl flex items-center gap-4 border border-white/20 z-10 transition-colors duration-500 ease-in-out">
                                <div class="{{ tokens.icon.circle }}">
                                    <span class="material-symbols-outlined text-green-600 dark:text-slate-900 transition-colors duration-500">verified</span>
                                </div>
                                <div>
                                    <p class="text-xs sm:text-sm font-semibold {{ tokens.text.title }} transition-colors duration-500">{{ 'Nächster freier Termin'|trans }}</p>
                                    <p class="text-sm sm:text-base text-primary dark:text-blue-400 font-bold transition-colors duration-500">{{ 'Heute, 14:30 Uhr'|trans }}</p>
                                </div>
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </section>

    {# About Section #}
    {# duration-500 sorgt jetzt für einen geschmeidigen, weichen Übergang beim Modus-Wechsel #}
    <section class="py-24 bg-background-light dark:bg-slate-800/50 border-y border-slate-100 dark:border-slate-800/60 transition-colors duration-500 ease-in-out overflow-hidden" id="about">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex flex-col-reverse lg:grid lg:grid-cols-2 gap-16 items-center">
                <div class="grid grid-cols-2 gap-4 overflow-hidden">
                    {% if content.about_images is not empty %}
                        {% for block in content.about_images %}
                            {% if block.image is not empty or block.image_mobile is not empty %}
                                {% set image = block.image|first %}
                                {% set image_mobile = block.image_mobile|first|default(image) %}
                                {% set variant = block.variant|default('square') %}
                                {% set mobile_variant = block.mobile_variant|default('square') %}

                                {% set quality = block.quality|default(global_best_quality ? 'best' : 'standard') %}
                                {% set mobile_quality = block.mobile_quality|default(global_best_quality ? 'best' : 'standard') %}
                                {% if quality == 'best' %}
                                    {% set desktop_format = variant ~ '-xl' %}
                                {% else %}
                                    {% set desktop_format = variant ~ '-lg' %}
                                {% endif %}
                                {% if mobile_quality == 'best' %}
                                    {% set mobile_format = mobile_variant ~ '-xl' %}
                                {% else %}
                                    {% set mobile_format = mobile_variant ~ '-md' %}
                                {% endif %}

                                <picture class="relative group">
                                    <source media="(max-width: 639px)" srcset="{{ image_mobile.thumbnails[mobile_format]|default(image_mobile.url) }}">
                                    <img src="{{ image.thumbnails[desktop_format]|default(image.thumbnails['square-md'])|default(image.url) }}"
                                         alt="{{ image.title }}"
                                         class="rounded-3xl {{ variant == 'horizontal' ? 'aspect-[4/3]' : (variant == 'vertical' ? 'aspect-[3/4]' : 'aspect-square') }} w-full object-cover border border-slate-200 dark:border-slate-800 transition-all duration-500 dark:brightness-95 dark:group-hover:brightness-100 block max-w-full"
                                         style="object-position: {{ image.focusX|default(50) }}% {{ image.focusY|default(50) }}%">
                                </picture>
                            {% endif %}
                        {% endfor %}
                    {% else %}
                        <img alt="Dental examination chair" class="rounded-3xl h-64 w-full object-cover shadow-lg mt-8 block max-w-full border border-slate-200 dark:border-slate-800 transition-all duration-500 dark:brightness-95" src="https://images.unsplash.com/photo-1629909608135-ca29ed974bb9?q=80&w=2047&auto=format&fit=crop">
                        <img alt="Modern dental equipment" class="rounded-3xl h-64 w-full object-cover shadow-lg block max-w-full border border-slate-200 dark:border-slate-800 transition-all duration-500 dark:brightness-95" src="https://images.unsplash.com/photo-1588776814546-1ffcf47267a5?q=80&w=2070&auto=format&fit=crop">
                        <img alt="Sterile tools" class="rounded-3xl h-64 w-full object-cover shadow-lg block max-w-full border border-slate-200 dark:border-slate-800 transition-all duration-500 dark:brightness-95" src="https://images.unsplash.com/photo-1597764690523-15bea4c581c9?q=80&w=2070&auto=format&fit=crop">
                        <img alt="Patient consultation" class="rounded-3xl h-64 w-full object-cover shadow-lg -mt-8 block max-w-full border border-slate-200 dark:border-slate-800 transition-all duration-500 dark:brightness-95" src="https://images.unsplash.com/photo-1606811841689-23dfddce3e95?q=80&w=1974&auto=format&fit=crop">
                    {% endif %}
                </div>

                <div class="space-y-6 min-w-0 overflow-hidden">
                    <div class="inline-flex items-center gap-2 text-blue-600 dark:text-blue-400 font-bold tracking-wider uppercase text-sm transition-colors duration-500">
                        <span class="w-8 h-px bg-blue-500"></span>
                        {{ content.about_badge|default('Über die Praxis'|trans) }}
                    </div>

                    <h2 class="text-3xl sm:text-4xl font-display font-bold {{ tokens.text.title }} break-words transition-colors duration-500">{{ content.about_title|default('Fachkompetente Betreuung für jeden Patienten'|trans) }}</h2>

                    {% if content.about_description_1 is not empty %}
                        <div class="text-lg {{ tokens.text.body }} leading-relaxed break-words overflow-hidden transition-colors duration-500">
                            {{ content.about_description_1|raw }}
                        </div>
                    {% endif %}
                    {% if content.about_description_2 is not empty %}
                        <div class="text-lg {{ tokens.text.body }} leading-relaxed break-words overflow-hidden transition-colors duration-500">
                            {{ content.about_description_2|raw }}
                        </div>
                    {% endif %}

                    {% if content.about_features is not empty %}
                        <div class="grid grid-cols-2 gap-6 pt-4">
                            {% for feature in content.about_features %}
                                <div class="flex items-start gap-3 min-w-0">
                                <div class="{{ tokens.icon.circle }} !rounded-lg">
                                    {% if feature.icon is not empty %}
                                        {% set icon = feature.icon|first %}
                                        <img src="{{ icon.url }}" alt="{{ icon.title }}" class="w-6 h-6 object-contain dark:brightness-0">
                                    {% else %}
                                        <span class="material-symbols-outlined text-xl text-primary dark:text-slate-900">verified</span>
                                    {% endif %}
                                </div>
                                    <div class="min-w-0">
                                        <h4 class="font-bold {{ tokens.text.title }} truncate transition-colors duration-500">{{ feature.title }}</h4>
                                        <p class="text-sm {{ tokens.text.muted }} truncate transition-colors duration-500">{{ feature.subtitle }}</p>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </section>

    {# Services Section #}
    {% set services_list = content.services_list|default([]) %}
    {% set services_selection = content.services_selection|default([]) %}
    {% if services_list is not empty or services_selection is not empty %}
        {# Sektion: Schaltet jetzt perfekt synchron und geschmeidig um (bg-slate-50 analog zur Hero-Sektion) #}
        <section class="py-24 bg-slate-100 dark:bg-slate-900/50 overflow-hidden transition-colors duration-500 ease-in-out" id="services">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center mb-12 sm:mb-16 min-w-0">
                {# Hauptüberschrift: Maximaler Kontrast im Lightmode + flüssiger Übergang #}
                <h2 class="text-3xl sm:text-4xl font-display font-bold {{ tokens.text.title }} mb-4 break-words transition-colors duration-500">{{ content.services_title|default('Unsere Kernleistungen'|trans) }}</h2>
                {% if content.services_subtitle is not empty %}
                    <div class="{{ tokens.text.body }} max-w-2xl mx-auto text-lg break-words overflow-hidden transition-colors duration-500">
                        {{ content.services_subtitle|raw }}
                    </div>
                {% endif %}
            </div>

            {% set use_carousel = content.services_carousel_enable|default(false) %}
            {% set carousel_height = content.services_carousel_height|default('large') %}
            {% set height_class = 'h-[500px] sm:h-[600px]' %}
            {% set width_class = 'max-w-7xl' %}
            {% if carousel_height == 'small' %}
                {% set height_class = 'h-[300px] sm:h-[400px]' %}
                {% set width_class = 'max-w-4xl' %}
            {% elseif carousel_height == 'medium' %}
                {% set height_class = 'h-[400px] sm:h-[500px]' %}
                {% set width_class = 'max-w-5xl' %}
            {% endif %}

            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                {% set services = [] %}
                {% if services_selection is not empty %}
                    {% for item in services_selection %}
                        {% if item.enabled|default(true) and item.page is not empty %}
                            {% set services = services|merge([item.page]) %}
                        {% endif %}
                    {% endfor %}
                {% else %}
                    {% for item in services_list %}
                        {% if item.enabled|default(false) %}
                            {% set services = services|merge([item]) %}
                        {% endif %}
                    {% endfor %}
                {% endif %}

                {% if services is not empty %}
                    {% if use_carousel %}
                        {% set show_autoplay = content.services_carousel_autoplay|default(true) %}
                        {% set seconds = content.services_carousel_autoplay_seconds|default(5) %}
                        {% set interval = show_autoplay and seconds > 0 ? seconds * 1000 : 'false' %}

                        <div id="servicesBootstrapCarousel" class="carousel slide" data-bs-ride="{{ show_autoplay ? 'carousel' : 'false' }}" data-bs-interval="{{ interval }}">
                            <!-- Indicators -->
                            <div class="carousel-indicators relative mt-8">
                                {% for i in 0..(services|length - 1) %}
                                    <button type="button" data-bs-target="#servicesBootstrapCarousel" data-bs-slide-to="{{ i }}" class="{{ loop.first ? 'active' : '' }} bg-primary" aria-current="{{ loop.first ? 'true' : 'false' }}" aria-label="Slide {{ i + 1 }}"></button>
                                {% endfor %}
                            </div>

                            <div class="carousel-inner">
                                {% for service in services %}
                                    <div class="carousel-item {{ loop.first ? 'active' : '' }}">
                                        <div class="px-md-5">
                                            <div class="{{ height_class }} {{ width_class }} mx-auto">
                                                {{ _self.render_service_card(service, services_selection is not empty) }}
                                            </div>
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>

                            {% if content.services_carousel_show_nav|default(false) %}
                                <!-- Controls: Pfeile faden jetzt ebenfalls smooth mit und wechseln sauber die Rahmenfarben -->
                                <button class="carousel-control-prev !left-[-5%] !w-[5%] !opacity-100 hidden lg:flex" type="button" data-bs-target="#servicesBootstrapCarousel" data-bs-slide="prev">
                            <span class="flex {{ tokens.icon.circle }} shadow-lg hover:bg-slate-50 dark:hover:bg-slate-700 transition-all duration-500 group !rounded-full">
                                <span class="material-symbols-outlined {{ tokens.text.title }} transition-colors duration-500">chevron_left</span>
                            </span>
                                </button>
                                <button class="carousel-control-next !right-[-5%] !w-[5%] !opacity-100 hidden lg:flex" type="button" data-bs-target="#servicesBootstrapCarousel" data-bs-slide="next">
                            <span class="flex {{ tokens.icon.circle }} shadow-lg hover:bg-slate-50 dark:hover:bg-slate-700 transition-all duration-500 group !rounded-full">
                                <span class="material-symbols-outlined {{ tokens.text.title }} transition-colors duration-500">chevron_right</span>
                            </span>
                                </button>
                            {% endif %}
                        </div>
                    {% else %}
                        <div class="grid md:grid-cols-2 {{ carousel_height == 'small' ? 'lg:grid-cols-4' : 'lg:grid-cols-3' }} gap-8 min-w-0">
                            {% for service in services %}
                                <div class="{{ height_class }}">
                                    {{ _self.render_service_card(service, services_selection is not empty) }}
                                </div>
                            {% endfor %}
                        </div>
                    {% endif %}
                {% endif %}
            </div>

            <style>
                /* Macht auch den Farbwechsel der Karussell-Punkte seidenweich */
                .carousel-indicators [data-bs-target] {
                    width: 12px;
                    height: 12px;
                    border-radius: 50%;
                    margin: 0 5px;
                    transition: background-color 0.5s ease-in-out, transform 0.3s ease;
                }
                .dark .carousel-indicators [data-bs-target] {
                    background-color: rgb(71 85 105); /* slate-600 */
                }
                .carousel-indicators [data-bs-target].active {
                    background-color: #2563eb;
                }
                .dark .carousel-indicators [data-bs-target].active {
                    background-color: rgb(255 255 255);
                }
                #servicesBootstrapCarousel .carousel-item {
                    transition: transform 0.6s ease-in-out;
                }
            </style>
        </section>
    {% endif %}

    {# Card partial to avoid repetition #}
    {% macro render_service_card(service, is_page) %}
        {% set image = null %}
        {% set image_mobile = null %}
        {% set variant = 'horizontal' %}
        {% set mobile_variant = 'horizontal' %}

        {% if is_page %}
            {% if service.excerpt.images is defined and service.excerpt.images is not empty %}
                {% set image = service.excerpt.images|first %}
                {% set image_mobile = image %}
            {% elseif service.images is defined and service.images is not empty %}
                {% set image = service.images|first %}
                {% set image_mobile = image %}
            {% endif %}
        {% else %}
            {% if service.image is defined and service.image is not empty %}
                {% set image = service.image|first %}
                {% set image_mobile = service.image_mobile|first|default(image) %}
                {% set variant = service.variant|default('horizontal') %}
                {% set mobile_variant = service.mobile_variant|default('horizontal') %}
            {% endif %}
        {% endif %}

        {% set has_image = image is not empty %}

        <div class="relative rounded-[2rem] {{ tokens.card.soft }} hover:shadow-2xl transition-all group min-w-0 overflow-hidden h-full flex flex-col text-left {{ not has_image ? 'p-6 sm:p-8' : '' }}">
            {% if has_image %}
                {# Full Background Image #}
                <div class="absolute inset-0 z-0">
                    <picture>
                        <source media="(max-width: 639px)" srcset="{{ (image_mobile.thumbnails[mobile_variant ~ '-md'] is defined ? image_mobile.thumbnails[mobile_variant ~ '-md'] : (image_mobile.thumbnails['horizontal-md'] is defined ? image_mobile.thumbnails['horizontal-md'] : (image_mobile.thumbnails['content-md'] is defined ? image_mobile.thumbnails['content-md'] : image_mobile.url))) }}">
                        <img src="{{ (image.thumbnails[variant ~ '-lg'] is defined ? image.thumbnails[variant ~ '-lg'] : (image.thumbnails['horizontal-lg'] is defined ? image.thumbnails['horizontal-lg'] : (image.thumbnails['content-lg'] is defined ? image.thumbnails['content-lg'] : image.url))) }}"
                             alt="{{ image.title|default(service.title) }}"
                             class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                             style="object-position: {{ image.focusX|default(50) }}% {{ image.focusY|default(50) }}%">
                    </picture>
                    <div class="absolute inset-0 bg-slate-900/40 group-hover:bg-slate-900/20 transition-colors duration-500"></div>
                    <div class="absolute inset-0 bg-gradient-to-t from-slate-900 via-slate-900/40 to-transparent"></div>
                </div>
            {% endif %}

            <div class="relative z-10 flex flex-col h-full {{ has_image ? 'p-6 sm:p-8 pt-20 sm:pt-24' : '' }}">
                <div class="{{ has_image ? 'w-12 h-12 sm:w-16 sm:h-16 rounded-2xl bg-white/20 backdrop-blur-md' : (tokens.icon.circle ~ ' !rounded-full') }} flex items-center justify-center mb-4 sm:mb-6 transition-colors flex-shrink-0">
                    {% if not is_page and service.icon is defined and service.icon is not empty %}
                        {% set icon = service.icon|first %}
                        <img src="{{ icon.url }}" alt="{{ icon.title }}" class="w-6 h-6 sm:w-10 sm:h-10 object-contain {{ has_image ? '' : 'dark:brightness-0 transition-all' }}">
                    {% else %}
                        <span class="material-symbols-outlined {{ has_image ? 'text-white' : 'text-primary dark:text-slate-900' }} text-2xl sm:text-3xl">medical_services</span>
                    {% endif %}
                </div>

                <h3 class="text-xl sm:text-2xl font-bold mb-3 sm:mb-4 break-words {{ has_image ? 'text-white' : tokens.text.title }}">{{ service.title }}</h3>

                <div class="mb-4 sm:mb-6 leading-relaxed break-words flex-grow overflow-y-auto no-scrollbar {{ has_image ? 'text-white/90' : tokens.text.body }}">
                    {% if is_page %}
                        {{ service.excerpt.description|default(service.title) }}
                    {% else %}
                        {{ service.description|raw }}
                    {% endif %}
                </div>

                {% if not is_page and service.features is defined and service.features is not empty %}
                    <ul class="space-y-2 sm:space-y-3 mb-6 sm:mb-8 text-left">
                        {% for feature in service.features %}
                            <li class="flex items-center gap-2 text-xs sm:text-sm min-w-0 {{ has_image ? 'text-white/80' : tokens.text.body }}">
                                <span class="material-symbols-outlined text-primary text-base flex-shrink-0">check_circle</span>
                                <span class="truncate">{{ feature.text }}</span>
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}

                {% set link = is_page ? sulu_content_path(service.url) : (service.link is defined and service.link is not empty ? sulu_content_path(service.link|first.url) : null) %}
                {% if link %}
                    <a class="inline-flex items-center font-bold hover:gap-2 transition-all mt-auto {{ has_image ? 'text-white' : 'text-primary' }}" href="{{ link }}">
                        {{ 'Mehr erfahren'|trans }} <span class="material-symbols-outlined ml-1">arrow_forward</span>
                    </a>
                {% endif %}
            </div>
        </div>
    {% endmacro %}

    {# News / Aktuelles Section #}
    {% if content.aktuelles_blocks is not empty %}
        {# Hintergrund: bg-slate-100 hebt sich im Lightmode perfekt von weiß ab | bg-slate-900/50 im Darkmode #}
        <section class="py-24 bg-slate-50 dark:bg-slate-800/50 border-t border-slate-200 dark:border-slate-800 transition-colors duration-500 ease-in-out overflow-hidden" id="aktuelles">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="text-center mb-12 sm:mb-16">
                    {# Sektions-Überschrift: Jetzt in tiefem, klarem text-slate-950 #}
                    <h2 class="text-3xl sm:text-4xl font-display font-bold {{ tokens.text.title }} mb-4 break-words transition-colors duration-500">{{ content.aktuelles_title|default('Aktuelles'|trans) }}</h2>
                </div>

                <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
                    {% for item in content.aktuelles_blocks %}
                        {# Karten: Reinweiß im Lightmode, tiefes Dunkelgrau im Darkmode #}
                        <div class="{{ tokens.card.soft }} p-8 rounded-[2rem] shadow-sm transition-all duration-500 min-w-0 overflow-hidden">
                            <div class="flex items-center gap-4 mb-6">
                                {# Icon-Box #}
                                <div class="{{ tokens.icon.circle }} !rounded-full">
                                    <span class="material-symbols-outlined text-2xl flex items-center justify-center leading-none">notifications</span>
                                </div>
                                <div class="min-w-0">
                                    {# Karten-Titel #}
                                    <h3 class="text-xl font-bold {{ tokens.text.title }} truncate transition-colors duration-500">{{ item.title }}</h3>
                                    {% if item.date is not empty %}
                                        <p class="text-sm {{ tokens.text.muted }} truncate mt-0.5 transition-colors duration-500">{{ item.date }}</p>
                                    {% endif %}
                                </div>
                            </div>
                            {# Beschreibungstext #}
                            <div class="{{ tokens.text.body }} break-words overflow-hidden text-sm leading-relaxed transition-colors duration-500">
                                {{ item.text|raw }}
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>
        </section>
    {% endif %}

    {# Contact Section #}
    {# Wechselt jetzt sauber zwischen hellem Graublau (bg-slate-50) und edlem Darkmode-Anthrazit (dark:bg-slate-900/50) #}
    <section class="py-24 bg-slate-100 dark:bg-slate-900/50 border-t border-slate-200 dark:border-slate-800 transition-colors overflow-hidden" id="contact">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid lg:grid-cols-2 gap-16 items-center">
                <div class="min-w-0 overflow-hidden">
                    {# Hauptüberschrift: Dunkel im Lightmode, Weiß im Darkmode #}
                    <h2 class="text-3xl sm:text-4xl font-display font-bold {{ tokens.text.title }} mb-8 break-words">{{ content.visit_title|default('Besuchen Sie uns'|trans) }}</h2>
                    <div class="space-y-6">
                        {% if addressSettings %}
                            {% if addressSettings.content.address is defined and addressSettings.content.address %}
                                <div class="flex items-start gap-4">
                                    {# Icon-Box #}
                                    <div class="{{ tokens.icon.circle }}">
                                        <span class="material-symbols-outlined text-2xl flex items-center justify-center leading-none">location_on</span>
                                    </div>
                                    <div class="min-w-0">
                                        <h4 class="font-bold {{ tokens.text.title }} text-lg truncate">{{ 'Unser Standort'|trans }}</h4>
                                        <div class="{{ tokens.text.body }} break-words overflow-hidden mt-0.5">
                                            {{ addressSettings.content.address|raw }}
                                        </div>
                                    </div>
                                </div>
                            {% endif %}

                            {% set hours = content.hours|default(addressSettings.content.hours|default([])) %}
                            <div class="flex items-start gap-4">
                                {# Icon-Box #}
                                <div class="{{ tokens.icon.circle }}">
                                    <span class="material-symbols-outlined text-2xl flex items-center justify-center leading-none">schedule</span>
                                </div>
                                <div class="min-w-0">
                                    <h4 class="font-bold {{ tokens.text.title }} text-lg truncate">{{ 'Öffnungszeiten'|trans }}</h4>
                                    <div class="{{ tokens.text.body }} break-words overflow-hidden mt-0.5 leading-relaxed">
                                        {% if hours is not empty %}
                                        <div class="space-y-1 text-sm">
                                            {% for entry in hours %}
                                                <div class="{{ tokens.text.body }}">
                                                <span class="{{ tokens.text.muted }}">
                                                    {{ entry.days }}:
                                                </span>
                                                    {{ entry.time }}
                                                </div>
                                            {% endfor %}
                                        </div>
                                        {% else %}
                                            {{ 'Mo - Fr: 08:00 - 18:00'|trans }}<br/>
                                            {{ 'Sa: 09:00 - 14:00'|trans }}
                                        {% endif %}
                                    </div>
                                </div>
                            </div>

                            {% if (addressSettings.content.email is defined and addressSettings.content.email) or (addressSettings.content.phone is defined and addressSettings.content.phone) %}
                                <div class="flex items-start gap-4">
                                    {# Icon-Box #}
                                    <div class="{{ tokens.icon.circle }}">
                                        <span class="material-symbols-outlined text-2xl flex items-center justify-center leading-none">alternate_email</span>
                                    </div>
                                    <div class="min-w-0">
                                        <h4 class="font-bold {{ tokens.text.title }} text-lg truncate">{{ 'E-Mail & Telefon'|trans }}</h4>
                                        <div class="{{ tokens.text.body }} break-words overflow-hidden mt-0.5 space-y-1">
                                            {% if addressSettings.content.email %}
                                                <a href="mailto:{{ addressSettings.content.email }}" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors block truncate">{{ addressSettings.content.email }}</a>
                                            {% endif %}
                                            {% if addressSettings.content.phone %}
                                                <a href="tel:{{ addressSettings.content.phone|replace({' ': ''}) }}" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors block truncate">{{ addressSettings.content.phone }}</a>
                                            {% endif %}
                                        </div>
                                    </div>
                                </div>
                            {% endif %}
                        {% endif %}
                    </div>

                    {# Blauer Notfall-Block #}
                    {% if content.emergency_text is not empty %}
                        <div class="mt-10">
                            {{ emergency.render(
                                content.emergency_title,
                                content.emergency_text,
                                addressSettings.content.phone|default('')
                            ) }}
                        </div>
                    {% endif %}
                </div>

                {# Rechte Spalte: Die Karte (Rahmen passt sich sauber an) #}
                <div class="rounded-[2.5rem] overflow-hidden shadow-2xl h-[500px] border-4 border-white dark:border-slate-800 relative group max-w-full">
                    {% set maps_url = content.map_link|default(addressSettings.content.map_link|default('')) %}
                    {% if maps_url is not empty %}
                        <iframe
                            src="{{ maps_url }}"
                            width="100%"
                            height="100%"
                            style="border:0;"
                            allowfullscreen=""
                            loading="lazy"
                            class="opacity-90 dark:opacity-70">
                        </iframe>
                    {% else %}
                        <img alt="Map Location" class="w-full h-full object-cover" src="https://images.unsplash.com/photo-1526778548025-fa2f459cd5c1?q=80&w=2033&auto=format&fit=crop">
                        <div class="absolute inset-0 bg-blue-600/10 group-hover:bg-transparent transition-colors"></div>
                    {% endif %}
                </div>
            </div>
        </div>
    </section>
{% endblock %}
