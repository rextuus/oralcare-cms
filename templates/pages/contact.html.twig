{% extends 'base.html.twig' %}

{% block content %}

    {% set common_settings = sulu_snippet_load_by_area('common_settings') %}
    {% set addressSettings = sulu_snippet_load_by_area('address_settings') %}

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 w-full overflow-x-hidden">

        {# ================= HEADER ================= #}
        <div class="mb-10">
            <h1 class="{{ tokens.text.title }} text-4xl font-bold mb-2 break-words">
                {{ content.title }}
            </h1>

            {% if content.subtitle is not empty %}
                <p class="{{ tokens.text.muted }}">
                    {{ content.subtitle }}
                </p>
            {% endif %}
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">

            {# ================= LEFT ================= #}
            <div class="lg:col-span-5 space-y-10">

                {% import "_components/contact/section_title.html.twig" as title %}
                {% import "_components/contact/icon.html.twig" as icon %}
                {% import "_components/contact/faq.html.twig" as faq %}
                {% import "_components/contact/emergency_box.html.twig" as emergency %}

                {# CONTACT SECTION TITLE #}
                {{ title.render('contact_support', 'So erreichen Sie uns') }}

                <div class="space-y-4">

                    {# ================= EMAIL ================= #}
                    {% set email = content.email|default(addressSettings.content.email|default('')) %}
                    {% if email is not empty %}

                        <a href="mailto:{{ email }}"
                           class="flex items-center p-4 {{ tokens.card.soft }} rounded-2xl group">

                            {{ icon.render('mail') }}

                            <div class="flex-grow ml-4 min-w-0">
                                <div class="{{ tokens.text.label }}">E-Mail</div>
                                <div class="{{ tokens.text.title }} truncate">
                                    {{ email }}
                                </div>
                            </div>

                            <span class="material-symbols-outlined text-slate-300 group-hover:text-primary">
                            chevron_right
                        </span>

                        </a>

                    {% endif %}

                    {# ================= PHONE ================= #}
                    {% set phone = content.phone|default(addressSettings.content.phone|default('')) %}
                    {% if phone is not empty %}

                        <a href="tel:{{ phone|replace({' ': ''}) }}"
                           class="flex items-center p-4 {{ tokens.card.soft }} rounded-2xl group">

                            {{ icon.render('call') }}

                            <div class="flex-grow ml-4 min-w-0">
                                <div class="{{ tokens.text.label }}">Telefon</div>
                                <div class="{{ tokens.text.title }} truncate">
                                    {{ phone }}
                                </div>
                            </div>

                            <span class="material-symbols-outlined text-slate-300 group-hover:text-primary">
                            chevron_right
                        </span>

                        </a>

                    {% endif %}

                    {# ================= BOOKING ================= #}
                    {% if content.booking_link is not empty and common_settings.content.enable_online_booking|default(false) %}
                        {% import "_components/contact/button.html.twig" as btn %}
                        <div class="p-4 {{ tokens.card.primary }} rounded-2xl group flex items-center justify-between gap-4">
                            <div class="flex items-center">
                                {{ icon.render('calendar_month') }}
                                <div class="flex-grow ml-4">
                                    <div class="text-xs uppercase tracking-wider text-primary/70 font-bold">
                                        {{ 'Online-Termin'|trans }}
                                    </div>
                                    <div class="font-bold text-primary">
                                        {{ 'Termin buchen'|trans }}
                                    </div>
                                </div>
                            </div>
                            {% set booking_url = sulu_content_path(content.booking_link.url) %}
                            {% set booking_onclick = null %}
                            {% if common_settings.content.dr_flex_practice_id|default(false) %}
                                {% set booking_url = 'javascript:triggerDrFlex()' %}
                            {% endif %}
                            {{ btn.primary(booking_url, null, 'Buchen'|trans, booking_onclick) }}
                        </div>
                    {% endif %}

                    {# ================= HOURS ================= #}
                    {% set hours = content.hours|default(addressSettings.content.hours|default([])) %}
                    {% if hours is not empty %}

                        <div class="p-4 {{ tokens.card.soft }} rounded-2xl">

                            <div class="flex items-center gap-4 mb-3">
                                {{ icon.render('schedule') }}

                                <div class="{{ tokens.text.label }}">
                                    Öffnungszeiten
                                </div>
                            </div>

                            <div class="space-y-1 text-sm">
                                {% for entry in hours %}
                                    <div class="{{ tokens.text.body }}">
                                    <span class="{{ tokens.text.muted }}">
                                        {{ entry.days }}:
                                    </span>
                                        {{ entry.time }}
                                    </div>
                                {% endfor %}
                            </div>

                        </div>

                    {% endif %}

                </div>

                {# ================= FAQ ================= #}
                {% if content.questions is not empty %}
                    {{ title.render('quiz', 'Häufige Fragen') }}
                    {{ faq.render(content.questions) }}
                {% endif %}

            </div>

            {# ================= RIGHT ================= #}
            <div class="lg:col-span-7 space-y-6">

                {% import "_components/contact/map_card.html.twig" as map %}
                {% import "_components/contact/info_card.html.twig" as info %}

                {# MAP ================= #}
                {{ map.render(
                    content.map_link|default(addressSettings.content.map_link|default('')),
                    content.address|default(addressSettings.content.address|default('')),
                    content.phone|default(addressSettings.content.phone|default(''))
                ) }}

                {# INFO CARDS ================= #}
                <div class="grid grid-cols-1 gap-6">

                    {% if content.emergency_info is not empty %}
                        {{ emergency.render(
                            'Notfallversorgung',
                            content.emergency_info,
                            addressSettings.content.phone|default('')
                        ) }}
                    {% endif %}

                    {% if content.languages_info is not empty %}
                        {{ info.render(
                            'language',
                            'Gesprochene Sprachen',
                            content.languages_info
                        ) }}
                    {% endif %}

                </div>

            </div>

        </div>
    </div>

{% endblock %}
