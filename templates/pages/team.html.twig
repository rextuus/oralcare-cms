{% extends 'base.html.twig' %}

{% block content %}

    {% set common_settings = sulu_snippet_load_by_area('common_settings') %}
    {% set global_best_quality = common_settings.content.force_best_quality|default(false) %}

    <div class="pt-6 md:pt-10 pb-10 px-1 sm:px-6 lg:px-8 max-w-7xl mx-auto w-full overflow-x-hidden transition-colors duration-500 ease-in-out">
        <div class="text-center mb-6 md:mb-10 min-w-0 w-full overflow-hidden">
            <h1 class="text-4xl md:text-5xl font-display font-bold mb-4 md:mb-6 text-slate-950 dark:text-white break-words hyphens-auto min-w-0 w-full max-w-full overflow-hidden transition-colors duration-500">{{ content.title }}</h1>
        </div>

        <div class="flex flex-wrap md:justify-center gap-2 md:gap-3 mb-6 md:mb-12 overflow-x-auto pb-4 md:pb-0 no-scrollbar" id="team-filter">
            <button data-filter="all" class="filter-btn whitespace-nowrap px-4 md:px-6 py-2 rounded-full bg-primary text-white font-medium shadow-md shadow-blue-500/10 hover:opacity-90 transition-all duration-500 active-filter border border-primary text-xs md:text-base">{{ 'Alle'|trans }}</button>
            <button data-filter="dentists" class="filter-btn whitespace-nowrap px-4 md:px-6 py-2 rounded-full bg-white dark:bg-slate-900 text-slate-950 dark:text-slate-950 font-medium border border-slate-200 dark:border-slate-800 hover:border-primary transition-all duration-500 text-xs md:text-base">{{ 'Zahnärzte'|trans }}</button>
            <button data-filter="reception" class="filter-btn whitespace-nowrap px-4 md:px-6 py-2 rounded-full bg-white dark:bg-slate-900 text-slate-950 dark:text-slate-950 font-medium border border-slate-200 dark:border-slate-800 hover:border-primary transition-all duration-500 text-xs md:text-base">{{ 'Empfang'|trans }}</button>
            <button data-filter="assistants" class="filter-btn whitespace-nowrap px-4 md:px-6 py-2 rounded-full bg-white dark:bg-slate-900 text-slate-950 dark:text-slate-950 font-medium border border-slate-200 dark:border-slate-800 hover:border-primary transition-all duration-500 text-xs md:text-base">{{ 'Assistenz'|trans }}</button>
            <button data-filter="prophylaxis" class="filter-btn whitespace-nowrap px-4 md:px-6 py-2 rounded-full bg-white dark:bg-slate-900 text-slate-950 dark:text-slate-950 font-medium border border-slate-200 dark:border-slate-800 hover:border-primary transition-all duration-500 text-xs md:text-base">{{ 'Prophylaxe'|trans }}</button>
        </div>

        <div class="p-2 md:p-4 grid grid-cols-2 sm:grid-cols-2 lg:grid-cols-4 gap-2 md:gap-8 transition-color duration-500" id="team-grid">
            {% for member in content.team_members %}
                {% set variant = member.variant|default('vertical') %}
                {% set mobile_variant = member.mobile_variant|default('vertical') %}
                {% set memberLink = member.link is not empty ? sulu_content_path(member.link|first.url) : null %}

                <div class="team-card team-card-inner group rounded-[1.5rem] md:rounded-[2rem] overflow-hidden transition-all duration-500 hover:shadow-2xl hover:-translate-y-2 opacity-100 scale-100"
                     data-category="{{ member.category|default('all') }}">
                    <div class="{{ variant == 'square' ? 'aspect-square' : (variant == 'horizontal' ? 'aspect-video' : 'aspect-[4/5]') }} overflow-hidden bg-slate-100 dark:bg-slate-900 relative">
                        {% if member.image is defined and (member.image is not empty or member.image_mobile is not empty) %}
                            {% set image = member.image|first %}
                            {% set image_mobile = member.image_mobile|first|default(image) %}
                            <picture>
                                <source media="(max-width: 639px)" srcset="{{ image_mobile.thumbnails[mobile_variant ~ '-md']|default(image_mobile.url) }}">
                                <img src="{{ image.thumbnails[variant ~ '-lg']|default(image.url) }}" alt="{{ member.name }}" class="w-full h-full object-cover grayscale-[0.9] group-hover:grayscale-0 transition-all duration-700 dark:brightness-90 dark:group-hover:brightness-100" style="object-position: {{ image.focusX|default(50) }}% {{ image.focusY|default(50) }}%">
                            </picture>
                        {% else %}
                            <img alt="{{ member.name }}" class="w-full h-full object-cover grayscale-[0.9] group-hover:grayscale-0 transition-all duration-700 dark:brightness-90 dark:group-hover:brightness-100" src="https://i.pravatar.cc/400?u={{ member.name|url_encode }}">
                        {% endif %}

                        {% if memberLink %}<a href="{{ memberLink }}" class="absolute inset-0 z-10" aria-label="{{ 'Detailseite von'|trans }} {{ member.name }}"></a>{% endif %}
                    </div>
                    <div class="p-4 md:p-6">
                        {% set badgeColorClass = 'bg-blue-50 text-primary dark-badge-blue' %}
                        {% if member.badge_color == 'purple' %}{% set badgeColorClass = 'bg-purple-50 text-purple-600 dark-badge-purple' %}
                        {% elseif member.badge_color == 'teal' %}{% set badgeColorClass = 'bg-teal-50 text-teal-600 dark-badge-teal' %}
                        {% elseif member.badge_color == 'amber' %}{% set badgeColorClass = 'bg-amber-50 text-amber-600 dark-badge-amber' %}{% endif %}

                        <span class="team-badge inline-block px-2 md:px-3 py-1 {{ badgeColorClass }} text-[10px] md:text-xs font-bold rounded-md uppercase tracking-wider mb-3 transition-colors duration-500">{{ member.role }}</span>

                        <h3 class="team-card-title text-base md:text-xl font-bold mb-1 transition-colors duration-500">
                            {% if memberLink %}<a href="{{ memberLink }}" class="hover:text-primary transition-colors duration-500">{{ member.name }}</a>
                            {% else %}{{ member.name }}{% endif %}
                        </h3>

                        <div class="team-card-desc text-xs md:text-sm mb-4 leading-relaxed transition-colors duration-500">{{ member.description|raw }}</div>

                        <div class="flex gap-2 relative z-20">
                            {% if member.email is not empty %}
                                <a href="mailto:{{ member.email }}" class="team-icon-btn w-9 h-9 rounded-xl flex items-center justify-center shadow-sm border hover:text-primary transition-all duration-500">
                                    <span class="material-symbols-outlined text-sm transition-colors duration-500">mail</span>
                                </a>
                            {% endif %}
                            {% if member.calendar_url is not empty %}
                                <a href="{{ member.calendar_url }}" target="_blank" class="team-icon-btn w-9 h-9 rounded-xl flex items-center justify-center shadow-sm border hover:text-primary transition-all duration-500">
                                    <span class="material-symbols-outlined text-sm transition-colors duration-500">calendar_month</span>
                                </a>
                            {% endif %}
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>

    <div id="role-description-container" class="grid transition-[grid-template-rows] duration-500 ease-in-out relative mt-16 text-center max-w-7xl mx-auto px-1 sm:px-6 lg:px-8" style="grid-template-rows: 1fr;">
            <div class="overflow-hidden relative min-h-[1.5em] bg-slate-100/50 dark:bg-slate-800/50 rounded-3xl p-6 md:p-8 border border-slate-100 dark:border-slate-800/50">
                <div id="default-subtitle" class="role-desc active transition-all duration-500 opacity-100 relative">
                    {% if content.subtitle is not empty %}
                        <div class="role-text-box text-lg md:text-xl text-slate-700 dark:text-slate-300 leading-relaxed break-words transition-colors duration-500">
                            {{ content.subtitle|raw }}
                        </div>
                    {% endif %}
                </div>
                <div id="desc-dentists" class="role-desc inactive transition-all duration-500 opacity-0 absolute inset-0 pointer-events-none flex items-center justify-center p-6 md:p-6">
                    {% if content.text_dentists is not empty %}
                        <div class="role-text-box text-lg md:text-xl text-slate-700 dark:text-slate-300 leading-relaxed break-words transition-colors duration-500">
                            {{ content.text_dentists|raw }}
                        </div>
                    {% endif %}
                </div>
                <div id="desc-reception" class="role-desc inactive transition-all duration-500 opacity-0 absolute inset-0 pointer-events-none flex items-center justify-center p-6 md:p-6">
                    {% if content.text_reception is not empty %}
                        <div class="role-text-box text-lg md:text-xl text-slate-700 dark:text-slate-300 leading-relaxed break-words transition-colors duration-500">
                            {{ content.text_reception|raw }}
                        </div>
                    {% endif %}
                </div>
                <div id="desc-assistants" class="role-desc inactive transition-all duration-500 opacity-0 absolute inset-0 pointer-events-none flex items-center justify-center p-6 md:p-6">
                    {% if content.text_assistants is not empty %}
                        <div class="role-text-box text-lg md:text-xl text-slate-700 dark:text-slate-300 leading-relaxed break-words transition-colors duration-500">
                            {{ content.text_assistants|raw }}
                        </div>
                    {% endif %}
                </div>
                <div id="desc-prophylaxis" class="role-desc inactive transition-all duration-500 opacity-0 absolute inset-0 pointer-events-none flex items-center justify-center p-6 md:p-6">
                    {% if content.text_prophylaxis is not empty %}
                        <div class="role-text-box text-lg md:text-xl text-slate-700 dark:text-slate-300 leading-relaxed break-words transition-colors duration-500">
                            {{ content.text_prophylaxis|raw }}
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

        {# Karriere CTA-Block #}
    {% if content.careers_title is not empty or content.careers_text is not empty %}
        <div class="w-full max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 mt-16 mb-16">
            <div class="bg-blue-200 dark:bg-slate-600 rounded-[40px] p-8 md:py-16 md:px-12 text-center border border-slate-200 dark:border-slate-800/60 transition-colors duration-500 ease-in-out">
                <h2 class="text-2xl md:text-3xl font-display font-bold mb-4 text-slate-950 dark:text-slate-100 transition-colors duration-500">
                    {{ content.careers_title }}
                </h2>
                <div class="text-slate-600 dark:text-slate-100 mb-8 max-w-xl mx-auto transition-colors duration-500 leading-relaxed">
                    {{ content.careers_text|raw }}
                </div>
                {% if content.careers_button_link is not empty %}
                    <a href="{{ sulu_content_path(content.careers_button_link|first.url) }}" class="inline-block bg-primary text-white font-bold px-8 py-3.5 rounded-xl hover:bg-blue-600 transition-all duration-500 shadow-xl shadow-blue-500/30">
                        {{ content.careers_button_text|default('Offene Stellen ansehen'|trans) }}
                    </a>
                {% endif %}
            </div>
        </div>
    {% endif %}

    <style>
        .no-scrollbar::-webkit-scrollbar { display: none; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }

        .role-desc.active {
            opacity: 1;
            position: relative;
            z-index: 10;
            pointer-events: auto;
        }

        .role-desc.inactive {
            opacity: 0;
            position: absolute;
            inset: 0;
            z-index: 0;
            pointer-events: none;
        }

        #team-grid {
            transition: all 0.5s ease-in-out;
        }

        .team-card.filtering-out {
            opacity: 0;
            transform: scale(0.9) translateY(20px);
            pointer-events: none;
            /* Wichtig: während der FLIP Animation sollte filtering-out nicht die transform überschreiben */
        }

        .team-card.filtering-in {
            opacity: 1;
            transform: scale(1) translateY(0);
        }

        /* Lightmode */
        .team-card-inner { background-color: #ffffff !important; border: 1px solid #f1f5f9 !important; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05); }
        .team-card-title, .team-card-title a { color: #0f172a !important; }
        .team-card-desc { color: #475569 !important; }
        .team-icon-btn { background-color: #f1f5f9 !important; border-color: #e2e8f0 !important; color: #1e293b !important; }

        /* Darkmode */
        .dark .role-text-box, .dark .role-text-box *,
        [data-theme="dark"] .role-text-box, [data-theme="dark"] .role-text-box * { color: #cbd5e1 !important; }

        .dark .team-card-inner, [data-theme="dark"] .team-card-inner { background-color: #343647 !important; border-color: #0f172a !important; }
        .dark .team-card-title, .dark .team-card-title a, [data-theme="dark"] .team-card-title, [data-theme="dark"] .team-card-title a { color: #ffffff !important; }

        /* Zwingt ALLE Elemente (p, strong, span) in der Beschreibung hell zu sein */
        .dark .team-card-desc, .dark .team-card-desc *, [data-theme="dark"] .team-card-desc, [data-theme="dark"] .team-card-desc * { color: #f1f5f9 !important; }

        .dark .team-icon-btn, [data-theme="dark"] .team-icon-btn { background-color: #0f172a !important; border-color: #1e293b !important; color: #f1f5f9 !important; }

        .dark .dark-badge-blue, [data-theme="dark"] .dark-badge-blue { background-color: rgba(30, 41, 59, 0.5) !important; color: #60a5fa !important; }
        .dark .dark-badge-purple, [data-theme="dark"] .dark-badge-purple { background-color: rgba(88, 28, 135, 0.3) !important; color: #c084fc !important; }
        .dark .dark-badge-teal, [data-theme="dark"] .dark-badge-teal { background-color: rgba(13, 148, 136, 0.2) !important; color: #2dd4bf !important; }
        .dark .dark-badge-amber, [data-theme="dark"] .dark-badge-amber { background-color: rgba(180, 83, 9, 0.2) !important; color: #fbbf24 !important; }
    </style>
{% endblock %}

{% block javascripts %}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const filterButtons = document.querySelectorAll('.filter-btn');
            const teamCards = document.querySelectorAll('.team-card');
            const roleDescriptions = document.querySelectorAll('.role-desc');
            const descriptionContainer = document.getElementById('role-description-container');

            filterButtons.forEach(button => {
                button.addEventListener('click', () => {
                    const filter = button.getAttribute('data-filter');

                    // --- FLIP Start: Positionen speichern ---
                    const visibleCards = Array.from(teamCards).filter(card => !card.classList.contains('hidden'));
                    const firstPositions = new Map();
                    visibleCards.forEach(card => {
                        firstPositions.set(card, card.getBoundingClientRect());
                    });
                    // --- FLIP End ---

                    // Active-Klassen für Buttons tauschen
                    filterButtons.forEach(btn => {
                        btn.classList.remove('bg-primary', 'text-white', 'shadow-md', 'shadow-blue-500/10', 'border-primary');
                        btn.classList.add('bg-white', 'dark:bg-slate-900', 'text-slate-950', 'dark:text-slate-300', 'border', 'border-slate-200', 'dark:border-slate-800');
                    });

                    button.classList.remove('bg-white', 'dark:bg-slate-900', 'text-slate-950', 'dark:text-slate-300', 'border', 'border-slate-200', 'dark:border-slate-800');
                    button.classList.add('bg-primary', 'text-white', 'shadow-md', 'shadow-blue-500/10', 'border-primary');

                    // Team-Karten filtern
                    teamCards.forEach(card => {
                        const isMatch = filter === 'all' || card.getAttribute('data-category') === filter;

                        if (isMatch) {
                            card.classList.remove('hidden');
                            card.classList.remove('filtering-out');
                            card.classList.add('filtering-in');
                            card.style.transform = ''; // Reset inline styles from previous animations
                            card.style.transition = '';
                        } else {
                            card.classList.remove('filtering-in');
                            card.classList.add('filtering-out');
                        }
                    });

                    // Force Reflow damit die neuen Positionen berechnet werden
                    document.body.offsetHeight;

                    // --- FLIP: Last, Invert, Play ---
                    const nextVisibleCards = Array.from(teamCards).filter(card => !card.classList.contains('hidden'));

                    nextVisibleCards.forEach(card => {
                        const firstRect = firstPositions.get(card);
                        if (!firstRect) {
                            // Karte war vorher nicht sichtbar -> Sanft einblenden
                            return;
                        }

                        const lastRect = card.getBoundingClientRect();
                        const dx = firstRect.left - lastRect.left;
                        const dy = firstRect.top - lastRect.top;

                        if (dx !== 0 || dy !== 0) {
                            // Invert: Zurück an die alte Stelle schieben (ohne Transition)
                            card.style.transition = 'none';
                            card.style.transform = `translate(${dx}px, ${dy}px)`;
                        }
                    });

                    // Zweiter Durchgang für das Play-Stadium nach einem Reflow
                    requestAnimationFrame(() => {
                        nextVisibleCards.forEach(card => {
                            if (!firstPositions.has(card)) return;

                            card.style.transition = 'transform 0.5s ease-in-out, opacity 0.5s ease-in-out';
                            card.style.transform = '';
                        });

                        // Ausgeblendete Karten erst nach der Transition auf hidden setzen
                        teamCards.forEach(card => {
                            if (card.classList.contains('filtering-out')) {
                                const onTransitionEnd = (e) => {
                                    if (e.propertyName === 'opacity' || e.propertyName === 'transform') {
                                        if (card.classList.contains('filtering-out')) {
                                            card.classList.add('hidden');
                                        }
                                        card.removeEventListener('transitionend', onTransitionEnd);
                                    }
                                };
                                card.addEventListener('transitionend', onTransitionEnd);
                                // Backup
                                setTimeout(() => {
                                    if (card.classList.contains('filtering-out')) {
                                        card.classList.add('hidden');
                                    }
                                }, 600);
                            }
                        });
                    });
                    // --- FLIP End ---

                    // Erklärtexte filtern mit smoother Cross-Fade Animation
                    const targetId = filter === 'all' ? 'default-subtitle' : 'desc-' + filter;
                    const activeDesc = document.getElementById(targetId);

                    if (activeDesc && !activeDesc.classList.contains('active')) {
                        roleDescriptions.forEach(desc => {
                            if (desc.id !== targetId) {
                                desc.classList.remove('active', 'opacity-100', 'relative');
                                desc.classList.add('inactive', 'opacity-0', 'absolute');
                            }
                        });

                        activeDesc.classList.remove('inactive', 'opacity-0', 'absolute');
                        activeDesc.classList.add('active', 'opacity-100', 'relative');
                    }
                });
            });
        });
    </script>
{% endblock %}
